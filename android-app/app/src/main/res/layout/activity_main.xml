<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#071018"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="U L T R O N"
        android:textColor="#38E8F4"
        android:textSize="27sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:gravity="center"
        android:paddingTop="10dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MOBILE SYSTEM • READY"
        android:textColor="#89AAB4"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#0D1B25"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/hud_orb" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="NEURAL INTERFACE  /  ONLINE"
            android:textColor="#38E8F4"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingBottom="9dp" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONVERSATION"
        android:textColor="#38E8F4"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingBottom="7dp" />

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#0A151E"
        android:padding="12dp">

        <TextView
            android:id="@+id/chatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ULTRON: Systems initialized. Add your Gemini API key in Settings to enable online AI, then send a message or use voice input."
            android:textColor="#E8F7FA"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />
    </ScrollView>

    <EditText
        android:id="@+id/messageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Enter command or ask ULTRON..."
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="3"
        android:minHeight="52dp"
        android:padding="12dp"
        android:textColor="#E8F7FA"
        android:textColorHint="#78939D"
        android:backgroundTint="#38E8F4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/sendButton"
            style="@style/UltronButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send" />

        <Button
            android:id="@+id/voiceButton"
            style="@style/UltronButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Voice" />

        <Button
            android:id="@+id/settingsButton"
            style="@style/UltronButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Settings" />
    </LinearLayout>
</LinearLayout>
